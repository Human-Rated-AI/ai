# Azure OpenAI Configuration (AI SDK format)
AZURE_API_KEY=your_azure_api_key_here
AZURE_BASE_URL=https://your-resource.openai.azure.com/openai
AZURE_DEPLOYMENT_NAME=gpt-5.5

# Application Configuration
PORT=3000
EXTERNAL_PORT=9000

# Langfuse tracking (optional)
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_BASE_URL=http://localhost:4000

# Port for Langfuse UI
# This value will be used for ${LANGFUSE_PORT} in compose.yml
LANGFUSE_PORT=4000

# A long, random string for security. Generate one with: openssl rand -base64 32
SALT=your_randomly_generated_salt_here

# --- SMTP Configuration for Gmail ---
# Use your 16-digit App Password here
SMTP_CONNECTION_URL="smtp://your.email@gmail.com:your-16-digit-app-password@smtp.gmail.com:587"
EMAIL_FROM_ADDRESS="your.email@gmail.com"

# --- Crucial Correction for Langfuse ---
# This MUST be your public-facing URL, not localhost.
# The value in your compose.yml should also be updated or removed to use this .env value.
NEXTAUTH_URL="https://stat.ai-api.hurated.com"
NEXTAUTH_SECRET=mysecret_or_better_generate_a_new_one

# Remote Deployment Configuration (optional)
# Used by deploy.sh for remote deployments
# Example: ./deploy.sh --remote-host ai-api.hurated.com ai
REMOTE_HOST=ai-api.hurated.com
REMOTE_USER=your_ssh_username
REMOTE_DIR=ai

# API Testing Configuration (optional)
# Used by test.sh as default API URL when no host is specified
# Example: ./test.sh 'Hello, world!'  # Uses AI_API_URL from .env
AI_API_URL=https://ai-api.hurated.com
